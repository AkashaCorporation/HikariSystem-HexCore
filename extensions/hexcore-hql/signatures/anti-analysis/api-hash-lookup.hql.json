{
  "id": "anti-analysis.api_hash_lookup",
  "version": "1.0.0",
  "namespace": "anti-analysis",
  "status": "released",
  "author": "AkashaCorporation",
  "license": "MIT",
  "provenance": { "kind": "internal", "source": "HexCore HQL rule library", "modified": true },
  "compatibility": { "hql": ">=0.2.0 <1.0.0", "helix": ">=0.9.3", "hastSchema": 1 },
  "fixtures": { "manifest": "v1/anti-analysis.api_hash_lookup.json" },
  "limitations": ["Structural XOR/shift/multiply loops are signals and may be ordinary hashing."],
  "name": "API Hash Lookup Loop",
  "description": "Detects the canonical hash-loop pattern used to resolve WinAPI imports without naming them in the import table. Looks for a for/while loop containing both a XOR (^) and a left-shift (<<) operation — the shape of djb2, ror13, fnv1a, and most rolling hash functions used in shellcode loaders.",
  "severity": "high",
  "mitre": ["T1027.007"],
  "evidenceLevel": "signal",
  "condition": {
    "any": [
      { "query": {
      "target": "CForStmt",
      "contains": [
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "^" }] },
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "<<" }] }
      ]
      } },
      { "query": {
      "target": "CWhileStmt",
      "contains": [
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "^" }] },
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "<<" }] }
      ]
      } },
      { "query": {
      "target": "CForStmt",
      "contains": [
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "^" }] },
        { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "*" }] }
      ]
      } }
    ]
  }
}
