  "severity": "info",
  "evidenceLevel": "signal",
  "condition": { "query": { "target": "CBinaryExpr", "attributes": [{ "field": "operator", "value": "re:^\\*=?$" }], "contains": [{ "target": "CIntLitExpr", "attributes": [{ "field": "value", "value": 16777619 }] }] } }
