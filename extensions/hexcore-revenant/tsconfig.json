{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"lib": ["ES2020"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"typeRoots": ["./node_modules/@types", "../hexcore-yara/node_modules/@types"],
		"types": ["node", "vscode"]
	},
	"exclude": ["node_modules", ".vscode-test"]
}
