		"gitDecoration.modifiedResourceForeground": "#a78bfa",
		"gitDecoration.deletedResourceForeground": "#f472b6",
		"gitDecoration.untrackedResourceForeground": "#34d399",
		"gitDecoration.ignoredResourceForeground": "#6d3fcc80",
