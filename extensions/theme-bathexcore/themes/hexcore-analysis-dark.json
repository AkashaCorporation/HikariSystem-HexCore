	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#7D8898", "fontStyle": "italic" }
		},
		{
			"name": "Control Flow",
			"scope": ["keyword.control", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop"],
			"settings": { "foreground": "#B5A4FF" }
		},
		{
			"name": "Storage and Types",
			"scope": ["storage", "storage.type", "storage.modifier", "entity.name.type", "entity.name.class", "entity.name.struct", "support.type", "support.class"],
			"settings": { "foreground": "#69C7D6" }
		},
		{
			"name": "Other Keywords",
			"scope": ["keyword", "keyword.operator.new", "keyword.operator.cast", "keyword.operator.sizeof"],
			"settings": { "foreground": "#A995F5" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
			"settings": { "foreground": "#69A7E6" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template", "string.other.link"],
			"settings": { "foreground": "#8BD5A7" }
		},
		{
			"name": "Numbers and Addresses",
			"scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
			"settings": { "foreground": "#E9BD65" }
		},
		{
			"name": "Constants",
			"scope": ["constant.language", "variable.other.constant", "variable.other.enummember"],
			"settings": { "foreground": "#E6A56F" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#D8B27C" }
		},
		{
			"name": "Properties",
			"scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
			"settings": { "foreground": "#C7D0DC" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
			"settings": { "foreground": "#929CAB" }
		},
		{
			"name": "Preprocessor and Annotations",
			"scope": ["meta.preprocessor", "keyword.control.directive", "meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
			"settings": { "foreground": "#E58AA5" }
		},
		{
			"name": "Regular Expressions and Escapes",
			"scope": ["string.regexp", "constant.other.character-class.regexp", "constant.character.escape"],
			"settings": { "foreground": "#69C7D6" }
		},
		{
			"name": "JSON Keys",
			"scope": ["support.type.property-name.json", "string.json support.type.property-name.json"],
			"settings": { "foreground": "#69A7E6" }
		},
		{
			"name": "Markdown Headings",
			"scope": ["markup.heading", "entity.name.section.markdown"],
			"settings": { "foreground": "#B5A4FF", "fontStyle": "bold" }
		},
		{
			"name": "Markdown Links",
			"scope": ["markup.underline.link", "string.other.link.description"],
			"settings": { "foreground": "#69C7D6" }
		},
		{
			"name": "Invalid and Deprecated",
			"scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
			"settings": { "foreground": "#FF6B78" }
		}
	],
	"semanticTokenColors": {
		"comment": { "foreground": "#7D8898", "italic": true },
		"keyword": "#B5A4FF",
		"function": "#69A7E6",
		"method": "#69A7E6",
		"type": "#69C7D6",
		"class": "#69C7D6",
		"struct": "#69C7D6",
		"interface": "#69C7D6",
		"enum": "#69C7D6",
		"enumMember": "#E6A56F",
		"parameter": "#D8B27C",
		"property": "#C7D0DC",
		"variable.readonly": "#E6A56F",
		"number": "#E9BD65",
		"string": "#8BD5A7",
		"regexp": "#69C7D6",
		"macro": "#E58AA5",
		"decorator": "#E58AA5"
	}
}
